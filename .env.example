# MongoDB Atlas connection string (required for profile, assessments, roadmap)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/gurukool
# Any OpenAI-compatible chat completions API (OpenAI, Groq, OpenRouter, Together, local Ollama...)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# Public link opened by the Connect module (e.g. a Google Meet / Discord / community URL)
NEXT_PUBLIC_CONNECT_URL=
# Signs login session cookies. Use a long random string (falls back to a hash of MONGODB_URI if unset).
AUTH_SECRET=
# Show the fictional demo mentors/recruiters/students/Bootcamp (seeded on first use). Keep false for real use.
GURUKOOL_SHOW_DEMO_DATA=false
